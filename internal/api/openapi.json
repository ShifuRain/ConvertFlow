{
  "openapi": "3.1.0",
  "info": {
    "title": "ConvertFlow API",
    "version": "1.0.0",
    "description": "Transcode video and audio with FFmpeg. There is no authentication: the service is intended for isolated networks. Optionally (CONVERTFLOW_SESSIONS) jobs belong to an owner: an anonymous session (cookie `cf_session`, issued by the server on GET /api/v1/presets, GET /api/v1/quota or the first job creation) or a user id set by a trusted reverse proxy. Then every job route only matches the caller's own jobs: another owner's job answers 404 exactly like a missing one, and the job list contains only the caller's jobs. Ownership is isolation between users, not authentication. Errors use RFC 9457 application/problem+json. Unknown /api paths answer 404 and unsupported methods 405 (with an Allow header), both as problem+json. Every route answers 421 when the request's Host header is not allowed (default: localhost and IP literals; see CONVERTFLOW_ALLOWED_HOSTS).",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "paths": {
    "/api/v1/jobs": {
      "post": {
        "operationId": "createJob",
        "summary": "Create a job: upload a file (multipart) or request a direct upload form (JSON)",
        "description": "multipart/form-data. Send exactly one of `preset` (a preset id) or `options` (a JSON object, see JobOptions) BEFORE the `file` part. Unknown fields are rejected. The file is streamed to disk; its name is only used for display. Alternatively, when the server stores media in an S3-compatible bucket, send application/json (PresignRequest): the request is validated exactly like a multipart upload (options, size limit, queue cap, upload slot), the job is created with status `uploading` and the response (201) carries a presigned POST form for the job's input. The client POSTs the form fields followed by the file (field `file`, last) to `upload.url`, then calls POST /api/v1/jobs/{id}/complete. With local storage a JSON request is refused like any non-multipart request (400). With sessions on, the job belongs to the caller (in cookie mode a session is created and its cookie set when the request has none). Quotas (CONVERTFLOW_QUOTA_*) are checked before any upload byte is stored where possible and again atomically when the job row is written: 429 with Retry-After when exceeded, 413 when the single file is larger than the queued-bytes quota.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "preset": {
                    "type": "string"
                  },
                  "options": {
                    "type": "string",
                    "contentMediaType": "application/json",
                    "description": "JSON-encoded JobOptions"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Direct upload form issued (JSON request); the job is `uploading`",
            "headers": {
              "Location": {
                "description": "URL of the new job",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignResponse"
                }
              }
            }
          },
          "202": {
            "description": "Job accepted",
            "headers": {
              "Location": {
                "description": "URL of the new job",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/CrossOrigin"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Busy"
          },
          "507": {
            "$ref": "#/components/responses/InsufficientStorage"
          }
        }
      },
      "get": {
        "operationId": "listJobs",
        "summary": "List the most recent jobs (newest first, at most 200); with sessions on only the caller's jobs",
        "responses": {
          "200": {
            "description": "Array of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get job status and progress",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      },
      "delete": {
        "operationId": "deleteJob",
        "summary": "Delete an idle job and its files, or request cancellation of an active one",
        "description": "Queued and finished jobs are deleted together with their input and output files (204). A probing or running job is only asked to stop (202): nothing is deleted by that first request; its files are removed when it reaches a terminal state, and a second DELETE removes the record.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation requested",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "canceling"
                      ]
                    }
                  }
                }
              }
            }
          },
          "204": {
            "description": "Deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/CrossOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "The job finished while the cancellation was requested; delete it again",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/api/v1/jobs/{id}/complete": {
      "post": {
        "operationId": "completeUpload",
        "summary": "Queue a job after its direct upload",
        "description": "Checks the uploaded object (its stored size must be 1..MAX_UPLOAD_BYTES and equal the announced size) and moves the job from `uploading` to `queued`. Idempotent: a job that already left `uploading` is returned unchanged (200). A rejected object is deleted, so the client may upload again while the form is valid. Only available with S3 storage (404 otherwise).",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "The job (queued, or its later state)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "The uploaded file is empty",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/CrossOrigin"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Nothing uploaded yet, size differs from the announced size, or the upload expired",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/api/v1/jobs/{id}/events": {
      "get": {
        "operationId": "streamJobEvents",
        "summary": "Server-Sent Events progress stream",
        "description": "Emits a `data:` line with the Job JSON whenever it changes, `: keepalive` comments while idle, and ends when the job reaches a terminal status, is deleted, or after a maximum connection lifetime (reconnect to continue). The number of concurrent streams is capped.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Busy"
          }
        }
      }
    },
    "/api/v1/jobs/{id}/output": {
      "get": {
        "operationId": "downloadOutput",
        "summary": "Download the result (supports Range requests)",
        "description": "Only jobs with status `done` are downloadable. The Content-Type is derived from the preset's container, the response is an attachment and carries `X-Content-Type-Options: nosniff`. With S3 storage the response is a 302 redirect (Cache-Control: no-store) to a short-lived presigned URL of the object store, which serves the same Content-Type and Content-Disposition.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Byte range, e.g. bytes=0-1023"
          }
        ],
        "responses": {
          "200": {
            "description": "The converted file",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "audio/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial content",
            "content": {
              "audio/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "S3 storage: redirect to a presigned download URL",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Job is not done",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "The result has been removed (retention)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "416": {
            "description": "Range not satisfiable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/api/v1/presets": {
      "get": {
        "operationId": "listPresets",
        "summary": "Presets runnable on the currently live workers (after the flavor policy)",
        "responses": {
          "200": {
            "description": "Array of presets (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Preset"
                  }
                }
              }
            },
            "headers": {
              "ConvertFlow-Upload-Mode": {
                "description": "How browsers should upload: \"presigned\" (JSON create, form POST straight to the object store, then POST /api/v1/jobs/{id}/complete) or \"multipart\" (multipart/form-data POST /api/v1/jobs). Non-browser clients may use either mode whenever the server supports it.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "presigned",
                    "multipart"
                  ]
                }
              }
            }
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "description": "In cookie session mode this is the page's first API call and creates the session (and sets its cookie) when the request has none, unless the per-IP session limit is reached; the presets are answered either way."
      }
    },
    "/api/v1/quota": {
      "get": {
        "operationId": "getQuota",
        "summary": "The caller's quota limits and current usage",
        "description": "In cookie mode this creates a session (and sets its cookie) when the request has none, unless the per-IP session limit is reached. Available in every session mode; with sessions off only the per-IP figures apply.",
        "responses": {
          "200": {
            "description": "Limits and usage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quota"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "summary": "Liveness check with a short database ping",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "summary": "Prometheus metrics (text exposition format)",
        "responses": {
          "200": {
            "description": "Metrics",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "JobId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Job id (lowercase UUID). Anything else is a 404."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed, interrupted or empty upload, or fields in the wrong order",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such job or endpoint (with sessions on, also a job of another owner)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The file exceeds the configured upload limit, or is larger than the caller's queued-bytes quota",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Invalid options, or the preset is not available on any running worker",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Internal": {
        "description": "Internal error (details are never disclosed)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Busy": {
        "description": "Too many concurrent uploads or streams, or the job queue is full; retry later",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying",
            "schema": {
              "type": "integer"
            }
          }
        }
      },
      "InsufficientStorage": {
        "description": "The server does not have enough free storage for the upload",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "CrossOrigin": {
        "description": "Refused: a browser marked the request as cross-origin (Sec-Fetch-Site other than same-origin/none, or an Origin that differs from the Host). Requests without these headers (curl, scripts) are not affected.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "MisdirectedRequest": {
        "description": "The Host header is not in the allow-list (DNS rebinding defense, CONVERTFLOW_ALLOWED_HOSTS). Applies to every route.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Header session mode only: the request carries no user identity from a trusted reverse proxy (the user header is missing, invalid, or the peer is not in CONVERTFLOW_TRUSTED_PROXIES).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "QuotaExceeded": {
        "description": "A per-owner or per-IP quota is exhausted (unfinished jobs, queued bytes, jobs per hour, active jobs per IP, or new sessions per IP). Retry after the indicated time; see GET /api/v1/quota.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying",
            "schema": {
              "type": "integer"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "JobOptions": {
        "type": "object",
        "required": [
          "preset"
        ],
        "additionalProperties": false,
        "properties": {
          "preset": {
            "type": "string"
          },
          "speed": {
            "type": "integer"
          },
          "crf": {
            "type": "integer"
          },
          "max_height": {
            "type": "integer"
          },
          "audio_bitrate_k": {
            "type": "integer"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "filename",
          "preset",
          "progress",
          "encoder_used",
          "attempts",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "queued",
              "probing",
              "running",
              "done",
              "failed",
              "canceled"
            ]
          },
          "filename": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "encoder_used": {
            "type": "string"
          },
          "probe": {
            "type": "object"
          },
          "error": {
            "type": "string"
          },
          "attempts": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "output_url": {
            "type": "string",
            "description": "Present when status is done"
          }
        }
      },
      "Preset": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "ext"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio"
            ]
          },
          "ext": {
            "type": "string"
          }
        }
      },
      "PresignRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size"
        ],
        "description": "Exactly one of preset and options.",
        "properties": {
          "preset": {
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/JobOptions"
          },
          "filename": {
            "type": "string",
            "description": "Display name only"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "description": "Size of the file in bytes; must match the uploaded object"
          }
        }
      },
      "PresignResponse": {
        "type": "object",
        "required": [
          "id",
          "upload",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "upload": {
            "type": "object",
            "required": [
              "url",
              "fields"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Form target (the object store)"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Form fields to send before the file, unchanged"
              }
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "The form is refused by the store after this time"
          }
        }
      },
      "QuotaCounts": {
        "type": "object",
        "required": [
          "active_jobs",
          "queued_bytes",
          "jobs_per_hour",
          "active_jobs_per_ip"
        ],
        "properties": {
          "active_jobs": {
            "type": "integer",
            "description": "Unfinished (uploading, queued, probing, running) jobs of the caller"
          },
          "queued_bytes": {
            "type": "integer",
            "description": "Summed input bytes of the caller's unfinished jobs"
          },
          "jobs_per_hour": {
            "type": "integer",
            "description": "Jobs the caller created in the trailing hour (counted only while that limit is set)"
          },
          "active_jobs_per_ip": {
            "type": "integer",
            "description": "Unfinished jobs created from the caller's IP address (IPv6: its /64; counted only while that limit is set)"
          }
        }
      },
      "Quota": {
        "type": "object",
        "required": [
          "sessions",
          "owner",
          "limits",
          "usage"
        ],
        "properties": {
          "sessions": {
            "type": "string",
            "enum": [
              "off",
              "cookie",
              "header"
            ]
          },
          "owner": {
            "type": "boolean",
            "description": "Whether the caller has an owner (a session or a proxy user). Without one the per-owner usage is zero."
          },
          "limits": {
            "allOf": [
              {
                "$ref": "#/components/schemas/QuotaCounts"
              }
            ],
            "description": "Configured limits; 0 means unlimited"
          },
          "usage": {
            "$ref": "#/components/schemas/QuotaCounts"
          },
          "jobs_per_hour_resets_in_seconds": {
            "type": "integer",
            "description": "Seconds until the oldest job of the trailing hour stops counting (absent when none counts)"
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cf_session",
        "description": "Cookie session mode only. Issued by the server (HttpOnly, SameSite=Strict, Path=/api/, Secure over TLS); a client-chosen value is never accepted. Optional: without it the caller simply has no jobs."
      }
    }
  }
}
