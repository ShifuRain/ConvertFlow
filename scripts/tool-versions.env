# Pinned versions of the supply-chain tooling used by CI, the release workflow and the scripts in this
# directory. Sourced by scripts and loaded into the workflow environment. Nothing here may be "latest".
# Bump deliberately (review the upstream changelog), run the scripts locally, commit.
GOVULNCHECK_VERSION=v1.9.0
GOSEC_VERSION=v2.29.0
GO_LICENSES_VERSION=v1.6.0
ACTIONLINT_VERSION=v1.7.12
CRANE_VERSION=v0.20.6   # v0.22.1 fails against ghcr.io anonymous tokens ("illegal base64 data") as of 2026-10
COSIGN_VERSION=v3.1.3
# Index (multi-arch) digests resolved from the registry with `podman pull` + `podman manifest inspect`.
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.76.0@sha256:2416d1f74045b57274df1a340eee6b510cacd73c66a6ccb8da092b117eb7d222
SYFT_IMAGE=ghcr.io/anchore/syft:v1.54.1@sha256:3eb5379ba7b409c3f4069b686110527af0c47df993fa5c10d13e7cf34f49b1aa
# S3-compatible store for the DEV/TEST profile (compose.s3.yaml, tests/container/s3.sh, CI) and the MinIO client used by
# scripts/s3-bootstrap.sh. Both are AGPL-3.0 and NOT distributed by this project (not in images, releases or the air-gap
# bundle); production deployments bring their own S3 service. The official minio images are no longer published, so these
# are Chainguard source rebuilds, whose free tier keeps only the newest build: refresh the digests when they stop resolving
# (scripts/check-pinned-digests.sh --online reports it). MINIO_IMAGE must equal the image of the s3 service in compose.s3.yaml.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:1011b924d7399cb10cb41c4d555bb858975ae0c0790bbdc54e1ad724e5613eb3
MC_IMAGE=cgr.dev/chainguard/minio-client@sha256:eec95b6c0a098eb24a41f7d9cdff6ae536497f1a22fc3e2c15ade97012e0b7f1
